# ---------------------------------------------------------------------------
# TrailMind — environment variables
#
# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is gitignored — never commit real credentials.
#
# Rule of thumb: NEXT_PUBLIC_* values are inlined into the browser bundle at
# build time, so only put values that are safe to expose to end users here.
# Firebase web app config keys are designed to be public; security comes from
# Firebase Security Rules, App Check and Auth — not from hiding these values.
# ---------------------------------------------------------------------------

# --- Firebase web app configuration --------------------------------------
# Firebase Console → Project settings → Your apps → (add a Web app)
# → SDK setup and configuration → npm → the firebaseConfig object
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional — only if you enable Firebase Analytics
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Firebase App Check ---------------------------------------------------
# Leave empty while developing. App Check is NOT initialised when this is
# unset, so the app keeps working without it.
# Firebase Console → App Check → register your web app → get the site key.
# Note: this SDK version only exposes the reCAPTCHA v3 / Enterprise providers.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# --- Firebase AI Logic ----------------------------------------------------
# Gemini model used for in-cloud inference through Firebase AI Logic.
# Check the Firebase AI Logic docs for the model IDs available to your project.
NEXT_PUBLIC_FIREBASE_AI_MODEL=gemini-2.5-flash

# --- Firebase Admin SDK (SERVER ONLY — never NEXT_PUBLIC_*) ---------------
# Used only by Route Handlers (token verification, dev seed). Leave empty for
# normal client-side operation — the app works without these.
# Firebase Console → Project settings → Service accounts → Generate new key.
# Paste the private key as-is; literal \n sequences are normalised on load.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Firebase Emulator Suite (local development) ---------------------------
# "true" points every client SDK (Auth/Firestore/Storage) and the Admin SDK
# at the local emulators instead of production. Requires emulators running.
# NEVER enable in a production build. When using emulators you may fill the
# NEXT_PUBLIC_FIREBASE_* web config with placeholder values (e.g. demo-*),
# as long as all required variables are non-empty.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
# Host the emulators listen on. Defaults to 127.0.0.1.
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# --- PWA / service worker -------------------------------------------------
# Off by default. Read `public/sw.js` before turning this on: the worker only
# caches a small static app shell and never caches authenticated responses.
NEXT_PUBLIC_ENABLE_SERVICE_WORKER=false
